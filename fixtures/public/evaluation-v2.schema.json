{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "med-agent evaluation-v2 case",
  "description": "公开结构契约；正式 v2 题目、标注和来源内容不随公开候选导出。",
  "type": "object",
  "required": [
    "case_id",
    "question",
    "split",
    "primary_stratum",
    "difficulty",
    "task_type",
    "annotation_status",
    "relevant",
    "hard_negative",
    "provenance"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "split": {"enum": ["tune", "dev", "test"]},
    "primary_stratum": {"enum": ["direct-hit", "paraphrase", "multi-clue", "out-of-domain"]},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "task_type": {"enum": ["direct", "paraphrase", "multi-clue", "multi-hop", "refusal", "conflict", "version-change"]},
    "annotation_status": {"enum": ["draft", "confirmed"]},
    "relevant": {"type": "array"},
    "hard_negative": {"type": "array"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
